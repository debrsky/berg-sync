# Исходная база Microsoft Access
MDB_PATH="C:/path/to/bergauto.mdb"

# Локальный PostgreSQL
PG_LOCAL_CONNECTION_STRING="Host=localhost;Port=5432;Database=bergdb;Username=postgres;Password=change_me;SSL Mode=Disable"

# Каталог неизменяемых пакетов инкрементальной синхронизации
DELTA_PACKAGE_DIR="./delta-packages"

# SSH alias или user@host для SFTP и запуска восстановления
HOSTING_SSH_TARGET="hosting-alias"
# Абсолютные пути к отдельным ключам пользователей (на bergvl — C:/Tools/berg_sync/ssh/).
HOSTING_SSH_KEY="C:/Tools/berg_sync/ssh/key"
HOSTING_SSH_KEY_ZHN="C:/Tools/berg_sync/ssh/key-zhn"

# Каталог полной выгрузки и скрипт восстановления на хостинге
HOSTING_TRANSFER_DIR="/home/hosting_user/berg-transfer"
HOSTING_RESTORE_SCRIPT="/home/hosting_user/berg-transfer/restore-hosting.sh"

# PostgreSQL на хостинге
PG_HOSTING_CONNECTION_STRING="Host=hosting.example.com;Port=5432;Database=bergdb;Username=berg_user;Password=change_me;SSL Mode=VerifyFull"
